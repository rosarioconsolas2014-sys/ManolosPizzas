{
  "entities": {
    "Player": {
      "title": "Player",
      "description": "Participante registrado identificado por su DNI para Manolo's Pizzas",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador único o DNI del jugador",
          "minLength": 4,
          "maxLength": 30
        },
        "nombre": {
          "type": "string",
          "description": "Nombre y apellido completo del participante",
          "minLength": 2,
          "maxLength": 100
        },
        "dni": {
          "type": "string",
          "description": "Número de DNI del participante",
          "minLength": 4,
          "maxLength": 20
        },
        "fechaRegistro": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha y hora de registro inicial"
        },
        "totalAttempts": {
          "type": "number",
          "description": "Cantidad de partidas realizadas"
        },
        "blocked": {
          "type": "boolean",
          "description": "Indica si el participante está temporalmente bloqueado"
        }
      },
      "required": ["nombre", "dni", "fechaRegistro"]
    },
    "GameResult": {
      "title": "GameResult",
      "description": "Resultado de partida completada en The Pizza Challenge",
      "type": "object",
      "properties": {
        "playerId": {
          "type": "string",
          "description": "DNI o identificador del participante",
          "minLength": 4,
          "maxLength": 30
        },
        "nombre": {
          "type": "string",
          "description": "Nombre del participante",
          "minLength": 2,
          "maxLength": 100
        },
        "dni": {
          "type": "string",
          "description": "DNI del participante",
          "minLength": 4,
          "maxLength": 20
        },
        "nivel1": {
          "type": "number",
          "description": "Puntaje obtenido en Nivel 1"
        },
        "nivel2": {
          "type": "number",
          "description": "Puntaje obtenido en Nivel 2"
        },
        "nivel3": {
          "type": "number",
          "description": "Puntaje obtenido en Nivel 3 (Memoria)"
        },
        "puntajeTotal": {
          "type": "number",
          "description": "Suma total de puntajes"
        },
        "tiempoTotal": {
          "type": "number",
          "description": "Tiempo acumulado en segundos"
        },
        "fecha": {
          "type": "string",
          "format": "date-time",
          "description": "Fecha de juego"
        },
        "mes": {
          "type": "string",
          "description": "Código o mes de juego (ej. 2026-11)",
          "maxLength": 10
        },
        "anio": {
          "type": "number",
          "description": "Año de la partida"
        }
      },
      "required": ["playerId", "nombre", "dni", "nivel1", "nivel2", "nivel3", "puntajeTotal", "tiempoTotal", "fecha", "mes", "anio"]
    },
    "MonthlyRanking": {
      "title": "MonthlyRanking",
      "description": "Puntajes consolidados del ranking mensual de Manolo's Pizzas",
      "type": "object",
      "properties": {
        "playerId": {
          "type": "string",
          "description": "DNI del jugador",
          "minLength": 4,
          "maxLength": 30
        },
        "nombre": {
          "type": "string",
          "description": "Nombre del jugador",
          "minLength": 2,
          "maxLength": 100
        },
        "puntaje": {
          "type": "number",
          "description": "Mejor puntaje del mes"
        },
        "mes": {
          "type": "string",
          "description": "Mes en formato YYYY-MM",
          "maxLength": 10
        },
        "anio": {
          "type": "number",
          "description": "Año correspondiente"
        }
      },
      "required": ["playerId", "nombre", "puntaje", "mes", "anio"]
    },
    "GameSettings": {
      "title": "GameSettings",
      "description": "Configuración centralizada del campeonato en settings/gameConfig (Gorillaz Gym style)",
      "type": "object",
      "properties": {
        "adminPasscode": { "type": "string", "description": "Passcode de acceso administrativo" },
        "competitionEnabled": { "type": "boolean", "description": "Habilita o deshabilita el campeonato" },
        "competitionTitle": { "type": "string", "description": "Nombre oficial del campeonato" },
        "startDate": { "type": "string", "description": "Fecha de inicio YYYY-MM-DD" },
        "endDate": { "type": "string", "description": "Fecha de fin YYYY-MM-DD" },
        "eventDate": { "type": "string", "description": "Fecha de entrega de premios" },
        "eventTime": { "type": "string", "description": "Hora del evento" },
        "eventLocation": { "type": "string", "description": "Lugar del evento" },
        "eventAddress": { "type": "string", "description": "Dirección del establecimiento" },
        "maxAttempts": { "type": "number", "description": "Cantidad máxima de intentos" },
        "unlimitedAttempts": { "type": "boolean", "description": "Si es true, ignora maxAttempts" },
        "prizeTitle": { "type": "string", "description": "Título o nombre del premio" },
        "prizeSubtitle": { "type": "string", "description": "Descripción corta o bajada promocional del premio" },
        "prizeImage": { "type": "string", "description": "URL o ruta de la imagen del premio" },
        "prizeQuantity": { "type": "number", "description": "Cantidad de premios" },
        "eventDescription": { "type": "string", "description": "Descripción o información adicional del evento" }
      }
    }
  },
  "firestore": {
    "/players/{playerId}": {
      "schema": {
        "$ref": "#/entities/Player"
      },
      "description": "Colección de participantes identificados por DNI"
    },
    "/gameResults/{resultId}": {
      "schema": {
        "$ref": "#/entities/GameResult"
      },
      "description": "Colección de partidas guardadas con puntajes por nivel y totales"
    },
    "/monthlyRanking/{rankingId}": {
      "schema": {
        "$ref": "#/entities/MonthlyRanking"
      },
      "description": "Colección de ranking mensual con el mejor puntaje de cada jugador"
    },
    "/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/GameSettings"
      },
      "description": "Configuración de evento, campeonato y premios en Firestore"
    },
    "/competitionsHistory/{historyId}": {
      "description": "Historial de ediciones anteriores y podios archivados"
    },
    "/config/settings": {
      "schema": {
        "$ref": "#/entities/GameSettings"
      },
      "description": "Configuración de juego y premio del mes (legacy)"
    }
  }
}
